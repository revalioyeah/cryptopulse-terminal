# CryptoPulse Terminal — Environment Variables (Capacitor / Vite Safe)
# Semua variabel opsional; fallback mock data realistis otomatis aktif bila kosong atau terkena rate-limit.

VITE_BINANCE_REST_URL=https://data-api.binance.vision
VITE_BINANCE_WS_URL=wss://data-stream.binance.vision/ws
VITE_COINGECKO_API_URL=https://api.coingecko.com/api/v3
VITE_FEAR_GREED_API_URL=https://api.alternative.me/fng/

# Opsional: API Keys eksternal untuk data derivatif & whale live
VITE_COINGLASS_API_KEY=
VITE_WHALE_ALERT_API_KEY=

# Opsional: Default Telegram Bot (juga dapat diisi langsung melalui Settings Modal)
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
