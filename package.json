{
  "name": "cryptopulse-terminal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "scanner:cloud": "node scripts/run-cloud-scanner.mjs",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "build:android": "npm run build && npx cap sync android",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.4",
    "lightweight-charts": "^5.3.0",
    "lucide-react": "^1.82.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "typescript": "~7.0.2",
    "vite": "^8.4.0"
  }
}
